# ===== 必填 =====
# DeepSeek API Key（LLM 对话）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# DashScope API Key（ASR 语音转写 + Embedding 向量化 + 视觉识别）
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ===== LLM 配置 =====
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# ===== Embedding 配置 =====
# qwen3.7-text-embedding（DashScope，支持自定义维度）；本项目固定 dimension=1024。
# 切换 Embedding 模型后必须重建向量库（清空知识库后重新入库）。
# 可选: qwen3.7-text-embedding / text-embedding-v4 / text-embedding-v3
EMBEDDING_MODEL=qwen3.7-text-embedding

# ===== ASR 语音识别配置 =====
# 当前 ASR 走 DashScope 实时识别接口，仅支持 paraformer-v2 / paraformer-v1
# （代码内自动映射为 paraformer-realtime-v2 / -v1）。
ASR_MODEL=paraformer-v2

# ===== 视觉识别配置 =====
# 多模态视觉模型，用于图文笔记OCR文字提取
# qwen3.7-flash：Qwen3 系列，具视觉理解能力，速度快、成本低
# 可选: qwen3.7-flash / qwen3.7-plus / qwen3.6-flash / qwen-vl-max-latest
VISION_MODEL=qwen3.7-flash

# ===== 检索参数（保持默认即可）=====
RETRIEVAL_TOP_K=8
RETRIEVAL_MMR_FETCH_K=32
RETRIEVAL_MMR_LAMBDA=0.55
RAG_CONTEXT_COUNT=5
RAG_PROMPT_MAX_CONTEXT_CHARS=8000

# ===== 切块参数 =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ===== 对话 =====
CHAT_HISTORY_WINDOW=6
CHAT_MAX_CONTENT_CHARS=2000

# ===== 数据库 =====
DATABASE_URL=sqlite:///app/storage/douyinrag.db
CHROMA_PERSIST_DIR=app/storage/chroma

# ===== 音频缓存 =====
AUDIO_CACHE_DIR=app/storage/audio_cache
